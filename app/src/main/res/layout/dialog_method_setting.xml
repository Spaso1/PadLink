<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@color/black"
              android:padding="16dp">

    <RadioGroup
            android:id="@+id/connectionTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <RadioButton
                android:id="@+id/tcpRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TCP" />

        <RadioButton
                android:id="@+id/udpRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UDP" />
    </RadioGroup>

    <LinearLayout
            android:id="@+id/udpInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="16dp">

        <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="UDP Host">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/udpHostInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <View android:layout_width="match_parent" android:layout_height="5dp"/>
        <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="UDP Port">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/udpPortInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <Button
                android:id="@+id/cancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless" />

        <Button
                android:id="@+id/confirmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="确认"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
